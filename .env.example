# 복사본 .env 는 infra/scripts/init-env.sh 가 무작위 값으로 만든다. .env 는 Git 에 올리지 않는다.
# 이 파일에는 실제 값을 넣지 않는다.

# 브라우저가 보는 주소
# 브라우저 접속은 HTTPS 만 (인증서: infra/secrets/tls, init-env.sh 가 생성)
KC_PUBLIC_URL=https://localhost:8081
INTERNAL_BASE_URL=https://localhost:8080
EXTERNAL_BASE_URL=https://localhost:8090
# 세션 쿠키 Secure 속성 (HTTPS 에서만 전송). 끄지 않는다.
COOKIE_SECURE=true

# Keycloak 운영 관리자 (infra_admin) 와 시험 계정 공통 비밀번호
KC_BOOTSTRAP_ADMIN_USERNAME=infra_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_TEST_PASSWORD=change-me

# Keycloak client secret
INTERNAL_WEB_CLIENT_SECRET=change-me
EXTERNAL_WEB_CLIENT_SECRET=change-me
TRANSFER_API_CLIENT_SECRET=change-me
EXTERNAL_API_CLIENT_SECRET=change-me

# DB (소유자 계정은 초기화에만, 앱은 app_user 계정)
BUSINESS_DB_OWNER_PASSWORD=change-me
BUSINESS_DB_APP_PASSWORD=change-me
TRANSFER_DB_OWNER_PASSWORD=change-me
TRANSFER_DB_APP_PASSWORD=change-me
